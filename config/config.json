# Ignore configuration for pipewire-audio-idle-inhibit
#
# Applications listed here will not trigger idle inhibition.
# Use the app name as shown in the inhibition table output.
#
# Config file search order (first found wins):
#   $XDG_CONFIG_HOME/pipewire-audio-idle-inhibit/config.json
#   /etc/pipewire-audio-idle-inhibit/config.json
#   /usr/share/pipewire-audio-idle-inhibit/config.json

{
    # Ignore these apps only for input (microphone/recording)
    input: [],

    # Ignore these apps only for output (speakers/playback)
    output: [],

    # Ignore these apps for both input and output
    both: [],

    # Idle inhibition method: "wayland" (default) or "systemd"
    inhibition_type: wayland
}
