[Unit]
Description=Pipewire Audio Idle Inhibit daemon
Documentation=https://github.com/The1fEst/PipewireAudioIdleInhibit
PartOf=graphical-session.target
After=graphical-session.target
# ConditionEnvironment requires systemd v247 to work correctly
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=@bindir@/pipewire-audio-idle-inhibit
Restart=on-failure

[Install]
WantedBy=graphical-session.target
